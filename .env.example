# .env.example (copy to .env, fill in real values, NEVER commit to git)

# ── App ────────────────────────────────────────────────────
ENV=development
LOG_LEVEL=info
PORT=8000

# ── PostgreSQL ─────────────────────────────────────────────
DATABASE_URL=postgresql+asyncpg://postgres:postgres@db:5432/assistant_db

# ── Redis ──────────────────────────────────────────────────
REDIS_URL=redis://cache:6379/0

# ── LLM ────────────────────────────────────────────────────
OLLAMA_BASE_URL=http://host.docker.internal:11434
LLM_MODEL=mistral
EMBEDDING_MODEL=nomic-embed-text

# ── Gemini (optional cloud fallback) ───────────────────────
GEMINI_API_KEY=your-gemini-key-here

# ── RAG Tuning ─────────────────────────────────────────────
RAG_TOP_K=20
RAG_TOP_N=5
MAX_CONTEXT_MESSAGES=20
CHUNK_SIZE=400
CHUNK_OVERLAP=50
